{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "lint:install": { "inputs": ["package.json", "pnpm-lock.yaml", "pnpm-workspace.yaml"] },
    "build:tsc": { "dependsOn": ["lint:install"] },
    "build:vite": { "dependsOn": ["build:tsc"], "outputs": ["dist/**"] },
    "lint:format": { "dependsOn": ["lint:install"] },
    "lint:issues": { "dependsOn": ["lint:install"] },
    "lint:types": { "dependsOn": ["lint:install"] },
    "lint:tests": { "dependsOn": ["lint:install"] },
    "lint:knip": { "dependsOn": ["lint:install"] },
    "test:unit": { "dependsOn": ["lint:install"], "outputs": ["coverage/**"] },
    "lint:repo": { "dependsOn": ["build:vite"] }
  }
}
